{
  "name": "nextgen-invoice",
  "productName": "NextGen Invoice",
  "version": "1.0.5", 
  "description": "Professional Invoice and EMI Management System",
  "author": "Isnu Gupta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nextgentechstack.invoice",
    "productName": "Invoice Generator",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Backend/dist/invoice_backend.exe",
        "to": "backend/invoice_backend.exe",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}