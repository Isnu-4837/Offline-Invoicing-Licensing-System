{
  "name": "key-generator-app",
  "productName": "Key Generator Tool",
  "version": "1.0.0",
  "description": "Standalone offline activation key generator for NextGen Invoice",
  "author": "Isnu Gupta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.keygen.app",
    "productName": "Key Generator Tool",
    "win": {
      "target": "nsis",
      "icon": "keygen.ico"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}